# Required for the /contact quote form to deliver email to Randy (randy@kiwicoatingsaz.com).
# Sign up at https://resend.com, verify a sending domain (or use their onboarding@resend.dev
# sender for testing), then create an API key and paste it below.
RESEND_API_KEY=

# Optional: the "from" address the quote-request email is sent from. Must be on a domain
# verified in Resend. Falls back to Resend's shared testing sender if not set.
RESEND_FROM_EMAIL="Kiwi Coatings Website <onboarding@resend.dev>"
